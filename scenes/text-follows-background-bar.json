{
  "$schema": "../scene.schema.json",
  "configuration": {
    "theme": { "id": "slim" },
    "groups": {
      "sky": { "style": { "background": "#a8d8ff", "cornerRadius": 6, "paddingHorizontal": 2 }, "members": [{ "id": "date" }, { "id": "time" }] }
    },
    "widgets": [
      { "id": "plain", "type": "text", "text": "On the bar", "position": "left" },
      { "id": "light", "type": "text", "text": "Light blue", "position": "left", "style": { "background": "#a8d8ff", "cornerRadius": 6 } },
      { "id": "navy", "type": "text", "text": "Navy", "position": "left", "style": { "background": "#1c2a4a", "cornerRadius": 6 } },
      { "id": "date", "type": "clock", "format": "EEE d MMM", "position": "right" },
      { "id": "time", "type": "clock", "format": "HH:mm", "position": "right" }
    ]
  },
  "draw": "bar",
  "width": 600
}
